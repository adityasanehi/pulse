---
// The closing call to action on content pages: one primary action (self-host), one secondary (source).
import { REPO, SETUP_GUIDE } from "../config"
import GitHubMark from "./GitHubMark.astro"

interface Props {
  heading?: string
}
const { heading = "See it on your own Google Health data" } = Astro.props
---

<aside class="cta">
  <div>
    <h2>{heading}</h2>
    <p>Pulse runs with Docker Compose on a machine you own: the app and its Postgres database. Try the demo first; it needs no Google account.</p>
  </div>
  <div class="actions">
    <a class="button button-primary" href={SETUP_GUIDE}>Self-host Pulse</a>
    <a class="button button-quiet" href={REPO}><GitHubMark class="b-icon" />View source</a>
  </div>
</aside>

<style>
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
    padding: clamp(24px, 4vw, 40px);
    border-radius: 24px;
    background:
      radial-gradient(60% 120% at 100% 0%, rgb(0 147 231 / 0.14), transparent 70%),
      radial-gradient(50% 120% at 0% 100%, rgb(0 241 159 / 0.08), transparent 70%),
      linear-gradient(135deg, #1a2425 0%, #171e27 100%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08), 0 20px 50px rgb(0 0 0 / 0.35);
  }
  h2 {
    font-size: clamp(1.375rem, 2.6vw, 1.75rem);
  }
  p {
    margin-top: 8px;
    max-width: 52ch;
    color: var(--foreground-secondary);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
