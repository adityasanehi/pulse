---
import { render } from "astro:content"
import Base from "../../layouts/Base.astro"
import GetStarted from "../../components/GetStarted.astro"
import { getPosts, postModified, postPath } from "../../lib/posts"
import { article, breadcrumbs } from "../../lib/schema"

export async function getStaticPaths() {
  const posts = await getPosts()
  // The content loader logs a bad sketch and carries on without it; fail the build instead.
  for (const post of posts) {
    const want = (post.body?.match(/^```sketch$/gm) ?? []).length
    const got = (post.rendered?.html.match(/<figure class="sketch">/g) ?? []).length
    if (want !== got) throw new Error(`${post.id}: ${want} sketch blocks but ${got} rendered. See the [glob-loader] error above.`)
  }
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }))
}
const { post, posts } = Astro.props
const { Content, headings } = await render(post)
const d = post.data
const path = postPath(post.id)
const toc = headings.filter((h) => h.depth === 2)
// Prose words only: sketch specs and tables would inflate the count.
const words = (post.body ?? "").replace(/```[\s\S]*?```/g, "").replace(/^\|.*$/gm, "").split(/\s+/).filter(Boolean).length
const minutes = Math.max(1, Math.round(words / 230))
// Three other posts, preferring ones that share a tag.
const shared = (p: typeof post) => p.data.tags.filter((t: string) => d.tags.includes(t)).length
const more = posts
  .filter((p) => p.id !== post.id)
  .sort((a, b) => shared(b) - shared(a))
  .slice(0, 3)
const fmt = (iso: string) => new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })
const schema = [
  article(Astro.site!, { type: "Article", path, headline: d.title, description: d.description, published: d.published, modified: postModified(post) }),
  breadcrumbs(Astro.site!, [
    { name: "Pulse", path: "/" },
    { name: "Blog", path: "/blog/" },
    { name: d.title, path },
  ]),
]
---

<Base title={d.title} description={d.description} schema={schema} keywords={d.keywords} ogType="article">
  <article>
    <header class="wrap head">
      <nav aria-label="Breadcrumb" class="crumbs"><a href="/blog/">Blog</a></nav>
      <h1>{d.title}</h1>
      <p class="meta">
        <time datetime={d.published}>{fmt(d.published)}</time>
        <span> · {minutes} min read</span>
        {d.updated && <span> · Updated <time datetime={d.updated}>{fmt(d.updated)}</time></span>}
        {d.checked && d.checked !== d.updated && <span> · Facts about other products checked {fmt(d.checked)}</span>}
      </p>
    </header>

    <div class="wrap layout">
      <div class="post"><Content /></div>
      {
        toc.length > 2 && (
          <nav class="toc" aria-labelledby="toc-h">
            <h2 id="toc-h">On this page</h2>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </div>

    {
      more.length > 0 && (
        <nav class="wrap block more" aria-labelledby="more-h">
          <h2 id="more-h">Keep reading</h2>
          <ul>
            {more.map((p) => (
              <li>
                <a href={postPath(p.id)}>{p.data.title}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="wrap block"><GetStarted /></div>
  </article>
</Base>

<script>
  // Marks the contents entry for the section being read. Without script the list still works as links.
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>(".toc a")].map((a) => [decodeURIComponent(a.hash.slice(1)), a]))
  if (links.size) {
    const set = (id: string) => links.forEach((a, key) => a.setAttribute("aria-current", String(key === id)))
    const io = new IntersectionObserver(
      (entries) => {
        const seen = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)
        if (seen[0]) set(seen[0].target.id)
      },
      { rootMargin: "-110px 0px -65% 0px" },
    )
    links.forEach((_, id) => {
      const h = document.getElementById(id)
      if (h) io.observe(h)
    })
  }
</script>

<style>
  .head {
    padding-top: clamp(40px, 7vw, 88px);
    max-width: calc(min(100% - 2 * var(--gutter), var(--page)));
  }
  .crumbs a {
    color: var(--muted-foreground);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--foreground);
  }
  h1 {
    margin-top: 12px;
    max-width: 22ch;
    font-size: clamp(2.125rem, 5vw, 3.5rem);
    letter-spacing: -0.035em;
    line-height: 1.06;
  }
  .meta {
    margin-top: 20px;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 64px;
    margin-top: 56px;
  }
  @media (min-width: 1100px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 220px;
    }
  }
  .toc {
    display: none;
  }
  @media (min-width: 1100px) {
    .toc {
      display: block;
      position: sticky;
      top: 112px;
      align-self: start;
      max-height: calc(100dvh - 140px);
      overflow-y: auto;
    }
  }
  .toc h2 {
    margin-bottom: 12px;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .toc ol {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
    box-shadow: inset 1px 0 0 rgb(255 255 255 / 0.1);
  }
  .toc a {
    display: block;
    padding: 6px 0 6px 14px;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    line-height: 1.35;
    text-decoration: none;
    transition: color 160ms;
  }
  .toc a:hover,
  .toc a[aria-current="true"] {
    color: var(--foreground);
  }
  .toc a[aria-current="true"] {
    box-shadow: inset 2px 0 0 var(--optimal);
  }
  .post {
    min-width: 0;
    color: var(--foreground-secondary);
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .post :global(> *) {
    max-width: 68ch;
  }
  .post :global(h2) {
    scroll-margin-top: 110px;
  }
  .post :global(> figure.sketch) {
    max-width: 100%;
    margin: 2.2em 0;
    container-type: inline-size;
  }
  .post :global(figure.sketch svg) {
    display: block;
    width: 100%;
    height: auto;
    max-width: 820px;
    overflow: visible;
  }
  /* Each figure carries a wide and a narrow drawing; the narrow one has larger text and stacked layouts. */
  .post :global(figure.sketch svg.narrow) {
    display: none;
    max-width: 480px;
  }
  @container (max-width: 560px) {
    .post :global(figure.sketch svg.wide) {
      display: none;
    }
    .post :global(figure.sketch svg.narrow) {
      display: block;
    }
  }
  .post :global(figure.sketch text) {
    font-family: "Caveat", cursive;
    font-weight: 500;
  }
  .post :global(figure.sketch figcaption) {
    max-width: 68ch;
    margin-top: 10px;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .post :global(> * + *) {
    margin-top: 1.1em;
  }
  .post :global(h2) {
    margin-top: 2.4em;
    color: var(--foreground);
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
    line-height: 1.25;
  }
  .post :global(h3) {
    margin-top: 1.8em;
    color: var(--foreground);
    font-size: 1.1875rem;
  }
  .post :global(> p:first-child) {
    color: var(--foreground);
    font-size: clamp(1.1875rem, 2vw, 1.3125rem);
    line-height: 1.55;
  }
  .post :global(strong) {
    color: var(--foreground);
  }
  .post :global(ul),
  .post :global(ol) {
    padding-left: 1.3em;
  }
  .post :global(li + li) {
    margin-top: 0.4em;
  }
  .post :global(li::marker) {
    color: var(--optimal);
  }
  .post :global(blockquote) {
    margin-inline: 0;
    padding-left: 18px;
    box-shadow: inset 2px 0 0 rgb(255 255 255 / 0.2);
  }
  .post :global(code) {
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: rgb(255 255 255 / 0.07);
    font-size: 0.9em;
  }
  .post :global(pre) {
    overflow-x: auto;
    padding: 16px;
    border-radius: 10px;
    background: rgb(255 255 255 / 0.05) !important;
    font-size: 0.875rem;
  }
  .post :global(pre code) {
    padding: 0;
    background: none;
  }
  .post :global(table) {
    display: block;
    overflow-x: auto;
    max-width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .post :global(th),
  .post :global(td) {
    padding: 12px 16px 12px 0;
    text-align: left;
    vertical-align: top;
  }
  .post :global(thead th) {
    color: var(--foreground);
    font-weight: 600;
    box-shadow: inset 0 -1px 0 rgb(255 255 255 / 0.16);
  }
  .post :global(tbody tr + tr) {
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06);
  }
  .block {
    margin-top: 96px;
  }
  .more h2 {
    font-size: clamp(1.625rem, 3vw, 2.125rem);
    margin-bottom: 16px;
  }
  .more ul {
    display: grid;
    gap: 6px;
    padding: 0;
    list-style: none;
  }
  .more a {
    display: inline-block;
    padding: 6px 0;
    color: var(--foreground-secondary);
    font-size: 1.0625rem;
  }
  .more a:hover {
    color: var(--foreground);
  }
</style>
