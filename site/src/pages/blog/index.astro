---
import Base from "../../layouts/Base.astro"
import GetStarted from "../../components/GetStarted.astro"
import { getPosts, postPath } from "../../lib/posts"
import { breadcrumbs, collectionPage } from "../../lib/schema"

const posts = await getPosts()
const title = "Blog: wearable metrics explained"
const description = "Plain answers about readiness, HRV, strain, sleep scores and training load on Fitbit, Pixel Watch, Garmin, Amazfit and other wearables, with sources."
const keywords = [...new Set(posts.flatMap((p) => p.data.keywords.slice(0, 1)))]
const fmt = (iso: string) => new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" })
const schema = [
  collectionPage(Astro.site!, "/blog/", title, description, posts.map((p) => ({ name: p.data.title, path: postPath(p.id) }))),
  breadcrumbs(Astro.site!, [
    { name: "Pulse", path: "/" },
    { name: "Blog", path: "/blog/" },
  ]),
]
---

<Base title={title} description={description} schema={schema} keywords={keywords}>
  <header class="wrap head">
    <h1>Blog</h1>
    <p class="lede">What your wearable's numbers mean, why they move, and what to do when they look wrong. Every claim links to its source.</p>
  </header>
  <ul class="wrap list">
    {
      posts.map((p) => (
        <li>
          <a href={postPath(p.id)}>
            <time datetime={p.data.published}>{fmt(p.data.published)}</time>
            <span class="h">{p.data.title}</span>
            <span class="d">{p.data.description}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <div class="wrap block"><GetStarted /></div>
</Base>

<style>
  .head {
    padding-top: clamp(40px, 7vw, 88px);
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    letter-spacing: -0.035em;
  }
  .lede {
    margin-top: 18px;
    max-width: 56ch;
    color: var(--foreground-secondary);
    font-size: 1.1875rem;
  }
  .list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 56px;
    padding: 0;
    list-style: none;
  }
  .list a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: 24px 26px;
    border-radius: var(--radius-card);
    background: linear-gradient(180deg, var(--card-top), var(--card));
    box-shadow: inset 0 1px 0 var(--card-edge);
    text-decoration: none;
    transition: translate 220ms var(--ease-out-expo);
  }
  .list a:hover {
    translate: 0 -2px;
  }
  time {
    color: var(--muted-foreground);
    font-size: 0.8125rem;
  }
  .h {
    font-weight: 600;
    font-size: 1.1875rem;
    line-height: 1.3;
  }
  .d {
    color: var(--foreground-secondary);
    font-size: 0.9375rem;
  }
  .block {
    margin-top: 96px;
  }
  @media (max-width: 760px) {
    .list {
      grid-template-columns: 1fr;
    }
  }
</style>
