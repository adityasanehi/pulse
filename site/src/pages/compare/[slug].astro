---
import Base from "../../layouts/Base.astro"
import Faq from "../../components/Faq.astro"
import GetStarted from "../../components/GetStarted.astro"
import { COMPARISONS, type Comparison } from "../../data/compare"
import { article, breadcrumbs, faqPage } from "../../lib/schema"
import FurtherReading from "../../components/FurtherReading.astro"

export function getStaticPaths() {
  return COMPARISONS.map((c) => ({ params: { slug: c.slug }, props: { c } }))
}
const { c } = Astro.props as { c: Comparison }
const path = `/compare/${c.slug}/`
const others = COMPARISONS.filter((o) => o.slug !== c.slug)
const schema = [
  article(Astro.site!, { type: "Article", path, headline: c.h1, description: c.description, published: c.published, modified: c.checked }),
  breadcrumbs(Astro.site!, [
    { name: "Pulse", path: "/" },
    { name: "Compare", path: "/compare/" },
    { name: c.nav, path },
  ]),
  ...(c.faq?.length ? [faqPage(c.faq)] : []),
]
---

<Base title={c.title} description={c.description} schema={schema} keywords={c.keywords} ogType="article">
  <article>
    <header class="wrap head">
      <nav aria-label="Breadcrumb" class="crumbs"><a href="/compare/">Compare</a></nav>
      <h1>{c.h1}</h1>
      <p class="answer" set:html={c.answer} />
      <p class="checked">Facts about other products checked on <time datetime={c.checked}>{c.checked}</time>.</p>
    </header>

    <div class="wrap body">
      {
        c.sections.map((s) => (
          <section class="part">
            <h2>{s.h}</h2>
            {s.p?.map((t) => <p set:html={t} />)}
            {s.list && (
              <ul class="points">
                {s.list.map((t) => (
                  <li set:html={t} />
                ))}
              </ul>
            )}
            {s.table && (
              <div class="table-wrap">
                <table>
                  <caption>{s.table.caption}</caption>
                  <thead>
                    <tr>
                      {s.table.head.map((h) => (
                        <th scope="col">{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {s.table.rows.map((r) => (
                      <tr>
                        {r.map((cell, i) => (i === 0 ? <th scope="row" set:html={cell} /> : <td set:html={cell} />))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </section>
        ))
      }

      <section class="part">
        <h2>Sources</h2>
        <ol class="sources">
          {
            c.sources.map((s) => (
              <li>
                {s.url ? <a href={s.url}>{s.label}</a> : s.label}
              </li>
            ))
          }
        </ol>
      </section>
    </div>

    {
      c.faq && (
        <div class="wrap block">
          <Faq items={c.faq} />
        </div>
      )
    }

    <FurtherReading path={path} />

    <nav class="wrap block more" aria-labelledby="more-h">
      <h2 id="more-h">More comparisons</h2>
      <ul>{others.map((o) => <li><a href={`/compare/${o.slug}/`}>{o.h1}</a></li>)}</ul>
    </nav>

    <div class="wrap block"><GetStarted /></div>
  </article>
</Base>

<style>
  .head {
    padding-top: clamp(40px, 7vw, 88px);
    max-width: calc(min(100% - 2 * var(--gutter), var(--page)));
  }
  .crumbs a {
    color: var(--muted-foreground);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--foreground);
  }
  h1 {
    margin-top: 12px;
    max-width: 20ch;
    font-size: clamp(2.25rem, 5.4vw, 3.75rem);
    letter-spacing: -0.035em;
    line-height: 1.04;
  }
  .answer {
    margin-top: 24px;
    max-width: 60ch;
    color: var(--foreground);
    font-size: clamp(1.1875rem, 2vw, 1.375rem);
    line-height: 1.5;
  }
  .checked {
    margin-top: 16px;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }
  .body {
    margin-top: 72px;
  }
  /* Heading beside its text, as on the metric pages; a table spans both columns under the heading. */
  .part {
    display: grid;
    grid-template-columns: minmax(0, 260px) minmax(0, 1fr);
    gap: 16px 48px;
    align-content: start;
    padding: 40px 0;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08);
    color: var(--foreground-secondary);
  }
  .part > :global(*) {
    grid-column: 2;
  }
  .part > h2 {
    grid-column: 1;
    grid-row: 1;
    color: var(--foreground);
    font-size: 1.375rem;
    letter-spacing: -0.015em;
  }
  .part > .table-wrap {
    grid-column: 1 / -1;
    grid-row: auto;
  }
  @media (max-width: 760px) {
    .part {
      grid-template-columns: 1fr;
    }
    .part > :global(*),
    .part > h2 {
      grid-column: 1;
      grid-row: auto;
    }
  }
  .part > p {
    max-width: 68ch;
  }

  .points {
    display: grid;
    gap: 10px;
    max-width: 72ch;
    margin: 0;
    padding-left: 1.2em;
  }
  .points li::marker {
    color: var(--optimal);
  }
  .table-wrap {
    overflow-x: auto;
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
  }
  table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  caption {
    caption-side: bottom;
    padding-top: 14px;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
    text-align: left;
  }
  th,
  td {
    padding: 14px 16px 14px 0;
    text-align: left;
    vertical-align: top;
  }
  thead th {
    color: var(--foreground);
    font-weight: 600;
    box-shadow: inset 0 -1px 0 rgb(255 255 255 / 0.16);
  }
  tbody tr + tr {
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06);
  }
  tbody th {
    width: 22%;
    color: var(--foreground);
    font-weight: 600;
  }
  .sources {
    display: grid;
    gap: 8px;
    margin: 0;
    padding-left: 1.4em;
    font-size: 0.9375rem;
  }
  .block {
    margin-top: 96px;
  }
  .more h2 {
    font-size: clamp(1.625rem, 3vw, 2.125rem);
    margin-bottom: 16px;
  }
  .more ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 6px 48px;
    padding: 0;
    list-style: none;
  }
  .more a {
    display: inline-block;
    padding: 6px 0;
    color: var(--foreground-secondary);
    font-size: 1.0625rem;
  }
  .more a:hover {
    color: var(--foreground);
  }
</style>
