---
import Base from "../../layouts/Base.astro"
import GetStarted from "../../components/GetStarted.astro"
import { COMPARISONS } from "../../data/compare"
import { breadcrumbs, collectionPage } from "../../lib/schema"

const title = "Compare wearables, recovery scores and Google Health"
const description = "Dated comparisons of recovery and readiness scores across Fitbit Air, Google Health, WHOOP, Garmin, Amazfit and Oura, with what Pulse adds and what it does not."
const keywords = [...new Set(COMPARISONS.flatMap((c) => c.keywords.slice(0, 2)))]
const schema = [
  collectionPage(Astro.site!, "/compare/", title, description, COMPARISONS.map(c => ({ name: c.h1, path: `/compare/${c.slug}/` }))),
  breadcrumbs(Astro.site!, [
    { name: "Pulse", path: "/" },
    { name: "Compare", path: "/compare/" },
  ]),
]
---

<Base title={title} description={description} schema={schema} keywords={keywords}>
  <header class="wrap head">
    <h1>Compare</h1>
    <p class="lede">Straight answers for people comparing wearables, Google Health and their recovery scores. Every fact about another product is dated and links to its source.</p>
  </header>
  <ul class="wrap list">
    {
      COMPARISONS.map((c) => (
        <li>
          <a href={`/compare/${c.slug}/`}>
            <span class="h">{c.h1}</span>
            <span class="d">{c.description}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <div class="wrap block"><GetStarted /></div>
</Base>

<style>
  .head {
    padding-top: clamp(40px, 7vw, 88px);
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    letter-spacing: -0.035em;
  }
  .lede {
    margin-top: 18px;
    max-width: 56ch;
    color: var(--foreground-secondary);
    font-size: 1.1875rem;
  }
  .list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 56px;
    padding: 0;
    list-style: none;
  }
  .list a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: 24px 26px;
    border-radius: var(--radius-card);
    background: linear-gradient(180deg, var(--card-top), var(--card));
    box-shadow: inset 0 1px 0 var(--card-edge);
    text-decoration: none;
    transition: translate 220ms var(--ease-out-expo);
  }
  .list a:hover {
    translate: 0 -2px;
  }
  .h {
    font-weight: 600;
    font-size: 1.1875rem;
    line-height: 1.3;
  }
  .d {
    color: var(--foreground-secondary);
    font-size: 0.9375rem;
  }
  .block {
    margin-top: 96px;
  }
  @media (max-width: 760px) {
    .list {
      grid-template-columns: 1fr;
    }
  }
</style>
